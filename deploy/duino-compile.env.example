# /etc/duino-compile.env — site settings for the systemd unit.
# Shown by GET /v3/info/server:
SERVER_INFO_NAME=Example Compile Server
SERVER_INFO_LOCATION=Unknown
SERVER_INFO_COUNTRY=US
SERVER_INFO_OWNER=
SERVER_INFO_WEBSITE=
SERVER_INFO_DESCRIPTION=
# Tuning (defaults shown):
# MAX_CONCURRENT_COMPILES=<number of CPUs>
# COMPILE_QUEUE_TIMEOUT_MS=60000
# CLI_TIMEOUT_MS=120000
# LIB_ALLOWED_HOSTS=downloads.arduino.cc,github.com,codeload.github.com,objects.githubusercontent.com,raw.githubusercontent.com
